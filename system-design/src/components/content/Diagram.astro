---
export interface Props {
  caption?: string;
  alt?: string;
}
const { caption, alt } = Astro.props;
---

<figure class="diagram" aria-label={alt ?? caption}>
  <div class="diagram__body">
    <slot />
  </div>
  {caption && (
    <figcaption class="diagram__caption">{caption}</figcaption>
  )}
</figure>

<style>
  .diagram { margin: 2.5rem 0; }
  .diagram__body {
    background: var(--panel);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 1.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .diagram__body :global(svg) {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .diagram__caption {
    margin: 8px 0 0;
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.5;
  }
</style>
