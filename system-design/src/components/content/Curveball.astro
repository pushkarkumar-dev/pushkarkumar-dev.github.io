---
export interface Props {
  question?: string;
  /** Some content passes the question as `title`; accept either */
  title?: string;
}
const { question: q, title } = Astro.props;
const question = q ?? title;
---

<div class="curveball">
  <div class="curveball__question">
    <span class="curveball__label">Follow-up question</span>
    {question && <p class="curveball__q">{question}</p>}
  </div>
  <div class="curveball__hint">
    <slot />
  </div>
</div>

<style>
  .curveball {
    border-left: 4px solid var(--rule-strong);
    margin: 1.75rem 0;
    padding: 2px 0 2px 20px;
  }
  .curveball__label {
    display: block;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink-2);
    margin-bottom: 4px;
  }
  .curveball__q {
    margin: 0 0 8px;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.4;
  }
  .curveball__hint {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .curveball__hint :global(p) { margin: 0 0 0.5rem; }
  .curveball__hint :global(p:last-child) { margin-bottom: 0; }
  .curveball__hint :global(ul) {
    margin: 0.375rem 0;
    padding-left: 1.25rem;
  }
  .curveball__hint :global(li) { margin: 0.2rem 0; }
</style>
