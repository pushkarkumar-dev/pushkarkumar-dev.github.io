---
export interface QuestionRef {
  slug: string;
  title: string;
  difficulty?: 'mid' | 'senior' | 'staff';
}
export interface Props {
  items: QuestionRef[];
}
const { items } = Astro.props;

const base = import.meta.env.BASE_URL;

const levelName: Record<string, string> = { mid: 'Mid', senior: 'Senior', staff: 'Staff' };
const levelNum:  Record<string, number> = { mid: 1, senior: 2, staff: 3 };
---

<nav class="related" aria-label="Related questions">
  <p class="related__heading">Related questions</p>
  <ul class="related__list">
    {items.map(item => (
      <li>
        <a href={`${base}/${item.slug}/`} class="related__link">
          <span class="related__title">{item.title}</span>
          {item.difficulty && (
            <span class="related__diff level">
              <span class="meter" aria-hidden="true">
                {[1, 2, 3].map(n => <i class:list={[n <= (levelNum[item.difficulty!] ?? 0) && 'on']} />)}
              </span>
              {levelName[item.difficulty] ?? item.difficulty}
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .related {
    margin: 3rem 0 0;
    padding-top: 1.5rem;
    border-top: 1.5px solid var(--ink);
  }
  .related__heading {
    font-size: 1.25rem;
    font-weight: 800;
    font-variation-settings: 'wdth' 118;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .related__list li { margin: 0; border-bottom: 1px solid var(--rule); }
  .related__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 8px;
    margin: 0 -8px;
    text-decoration: none;
    color: var(--ink);
  }
  .related__link:hover { background: var(--raised); }
  .related__link:hover .related__title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .related__title { font-size: 1rem; font-weight: 600; }
  .related__diff { flex: none; font-size: 0.875rem; }
</style>
