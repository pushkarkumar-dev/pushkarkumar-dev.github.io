---
export interface Props {
  title?: string;
}
const { title = 'Capacity estimation' } = Astro.props;
---

<aside class="capacity" role="note">
  <div class="capacity__header">
    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
      <rect x="1" y="7" width="2.5" height="5" rx="1" fill="currentColor"/>
      <rect x="5.25" y="4" width="2.5" height="8" rx="1" fill="currentColor"/>
      <rect x="9.5" y="1" width="2.5" height="11" rx="1" fill="currentColor"/>
    </svg>
    {title}
  </div>
  <div class="capacity__body">
    <slot />
  </div>
</aside>

<style>
  .capacity {
    border-left: 4px solid var(--ink);
    margin: 2rem 0;
    padding: 2px 0 2px 20px;
  }
  .capacity__header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 800;
    font-variation-settings: 'wdth' 112;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .capacity__body {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink);
  }
  .capacity__body :global(p) { margin: 0 0 0.5rem; }
  .capacity__body :global(p:last-child) { margin-bottom: 0; }
  .capacity__body :global(.katex-display) {
    margin: 0.875rem 0;
    overflow-x: auto;
  }
  .capacity__body :global(ul), .capacity__body :global(ol) {
    margin: 0.5rem 0;
    padding-left: 1.25rem;
  }
  .capacity__body :global(li) { margin: 0.2rem 0; }
  .capacity__body :global(strong) { font-weight: 700; font-variant-numeric: tabular-nums; }
</style>
