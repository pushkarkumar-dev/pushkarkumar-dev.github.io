---
import Badge from './Badge.astro';

export interface Props {
  title: string;
  slug: string;
  category: string;
  difficulty: 'mid' | 'senior' | 'staff';
  summary: string;
  tags: string[];
  estimatedReadMinutes: number;
}

const { title, slug, category, difficulty, summary, tags, estimatedReadMinutes } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!-- One question as a list row. Tags stay in data-tags so search still matches them. -->
<a
  href={`${base}/${slug}/`}
  class="q-card"
  data-category={category}
  data-difficulty={difficulty}
  data-tags={tags.join(',')}
  data-title={title.toLowerCase()}
>
  <span class="q-card__main">
    <span class="q-card__title">{title}</span>
    <span class="q-card__summary">{summary}</span>
  </span>
  <span class="q-card__meta">
    <Badge variant="difficulty" value={difficulty} />
    <Badge variant="category" value={category} />
    <span class="q-card__time">{estimatedReadMinutes} min read</span>
  </span>
</a>

<style>
  .q-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 8px 32px;
    padding: 20px 12px;
    margin: 0 -12px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .q-card:hover { background: var(--raised); }
  .q-card:hover .q-card__title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }

  .q-card__main { display: flex; flex-direction: column; gap: 6px; min-width: 0; }

  .q-card__title {
    font-size: 1.125rem;
    font-weight: 700;
    font-variation-settings: 'wdth' 106;
    line-height: 1.3;
  }

  .q-card__summary {
    font-size: 0.9375rem;
    color: var(--ink-2);
    line-height: 1.5;
    max-width: 68ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .q-card__meta {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-content: start;
    gap: 4px 12px;
    padding-top: 3px;
  }
  .q-card__time {
    grid-column: 2;
    font-size: 0.875rem;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 720px) {
    .q-card { grid-template-columns: 1fr; }
    .q-card__meta { display: flex; flex-wrap: wrap; gap: 6px 16px; padding-top: 0; }
  }
</style>
