---
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<aside class="pitfall" role="note">
  <div class="pitfall__header">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M7 1.5L13 12.5H1L7 1.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <line x1="7" y1="5.5" x2="7" y2="8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <circle cx="7" cy="10.5" r="0.7" fill="currentColor"/>
    </svg>
    Pitfall — {title}
  </div>
  <div class="pitfall__body">
    <slot />
  </div>
</aside>

<style>
  .pitfall {
    background: rgba(200, 80, 60, 0.06);
    border: 1px solid rgba(200, 80, 60, 0.22);
    border-left: 3px solid rgba(200, 80, 60, 0.65);
    border-radius: var(--r-md);
    margin: 1.75rem 0;
    overflow: hidden;
  }
  .pitfall__header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.125rem;
    color: #d07060;
    font-family: 'Geist', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(200, 80, 60, 0.18);
  }
  .pitfall__body {
    padding: 0.875rem 1.125rem;
    font-size: 0.9125rem;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .pitfall__body :global(p) { margin: 0 0 0.5rem; }
  .pitfall__body :global(p:last-child) { margin-bottom: 0; }
  .pitfall__body :global(strong) { color: #d07060; }
  .pitfall__body :global(code) {
    font-size: 0.85em;
    background: rgba(200, 80, 60, 0.1);
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }
</style>
