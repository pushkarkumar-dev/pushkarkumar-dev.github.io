---
// No props — slot should contain bullet list or short paragraphs
---

<aside class="tldr" role="note" aria-label="Summary">
  <p class="tldr__header">TL;DR</p>
  <div class="tldr__body">
    <slot />
  </div>
</aside>

<style>
  .tldr {
    border-left: 4px solid var(--signal);
    margin: 2rem 0;
    padding: 2px 0 2px 20px;
  }
  .tldr__header {
    font-size: 0.9375rem;
    font-weight: 800;
    font-variation-settings: 'wdth' 112;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .tldr__body {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .tldr__body :global(ul) {
    margin: 0;
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .tldr__body :global(li) { margin: 0; }
  .tldr__body :global(p) { margin: 0; }
</style>
