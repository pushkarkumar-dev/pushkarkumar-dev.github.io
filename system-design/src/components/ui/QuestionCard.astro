---
import Badge from './Badge.astro';

export interface Props {
  title: string;
  slug: string;
  category: string;
  difficulty: 'mid' | 'senior' | 'staff';
  summary: string;
  tags: string[];
  estimatedReadMinutes: number;
}

const { title, slug, category, difficulty, summary, tags, estimatedReadMinutes } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a
  href={`${base}/${slug}/`}
  class="q-card"
  data-category={category}
  data-difficulty={difficulty}
  data-tags={tags.join(',')}
  data-title={title.toLowerCase()}
>
  <div class="q-card__top">
    <div class="q-card__badges">
      <Badge variant="difficulty" value={difficulty} />
      <Badge variant="category" value={category} />
    </div>
    <span class="q-card__time" aria-label={`${estimatedReadMinutes} minute read`}>
      {estimatedReadMinutes} min
    </span>
  </div>

  <h3 class="q-card__title">{title}</h3>
  <p class="q-card__summary">{summary}</p>

  <div class="q-card__footer">
    <div class="q-card__tags">
      {tags.slice(0, 3).map(tag => <Badge variant="tag" value={tag} />)}
    </div>
    <svg class="q-card__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M2 7h10M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
</a>

<style>
  .q-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem 1.375rem;
    background: var(--bg-card);
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--dur-fast),
      background var(--dur-fast),
      transform var(--dur-fast) var(--ease-out);
  }
  .q-card:hover {
    border-color: var(--accent-line);
    background: var(--bg-raised);
    transform: translateY(-2px);
  }

  .q-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .q-card__badges {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .q-card__time {
    font-family: 'Geist', system-ui, sans-serif;
    font-size: 0.72rem;
    color: var(--ink-4);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .q-card__title {
    font-family: 'Geist', system-ui, sans-serif;
    font-size: 0.9625rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.35;
    margin: 0;
    transition: color var(--dur-fast);
  }
  .q-card:hover .q-card__title { color: var(--accent); }

  .q-card__summary {
    font-size: 0.84rem;
    color: var(--ink-3);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .q-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }
  .q-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .q-card__arrow {
    color: var(--ink-4);
    flex-shrink: 0;
    transition: color var(--dur-fast), transform var(--dur-fast);
  }
  .q-card:hover .q-card__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
