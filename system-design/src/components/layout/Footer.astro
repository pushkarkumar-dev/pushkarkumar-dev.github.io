---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer class="sd-footer">
  <div class="wrap sd-footer__inner">
    <span>&copy; {year} Pushkar Kumar. System design notes.</span>

    <nav class="sd-footer__links" aria-label="Footer links">
      <a href={`${base}/`}>All questions</a>
      <a href="/index.html" data-astro-reload>Home</a>
      <a href="https://github.com/pushkar1005" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .sd-footer {
    border-top: 1.5px solid var(--ink);
    margin-top: auto;
    padding: 28px 0 40px;
    font-size: 0.9375rem;
    color: var(--ink-2);
  }
  .sd-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }
  .sd-footer__links { display: flex; flex-wrap: wrap; gap: 12px 24px; }
  .sd-footer__links a { color: var(--ink-2); }
  .sd-footer__links a:hover { color: var(--ink); }
</style>
