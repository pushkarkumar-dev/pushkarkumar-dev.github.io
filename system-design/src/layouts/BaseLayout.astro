---
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Staff-level system design interview prep — 60 questions with deep-dives, capacity math, and tradeoff analysis.',
  ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- No-FOUC theme script: runs before paint. Light unless the reader chose dark or prefers it. -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('sd-theme');
        var preferred = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', preferred);
      })();
    </script>

    <title>{title} | System Design</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | System Design`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Archivo: one family; the width axis (62–125) does the display work -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Global styles (tokens + Tailwind + prose) -->
    <style is:global>
      @import '../styles/globals.css';
    </style>

    <!-- View Transitions (cross-page cross-fade) -->
    <ClientRouter />

    <slot name="head" />
  </head>

  <body>
    <a href="#main-content" class="sr-only skip-link">Skip to content</a>

    <slot />

    <!-- Theme toggle global script -->
    <script is:inline>
      window.__setTheme = function (theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('sd-theme', theme);
      };
      window.__getTheme = function () {
        return document.documentElement.getAttribute('data-theme') || 'light';
      };
      // View transitions copy <html> attributes from the incoming page, which would
      // reset data-theme to the static default; re-apply the reader's choice.
      if (!window.__themeSwapHooked) {
        window.__themeSwapHooked = true;
        document.addEventListener('astro:after-swap', function () {
          var stored = localStorage.getItem('sd-theme');
          var t = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', t);
        });
      }
    </script>
  </body>
</html>
