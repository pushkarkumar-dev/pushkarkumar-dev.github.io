---
export interface Props {
  title?: string;
}
const { title = 'Capacity estimation' } = Astro.props;
---

<aside class="capacity" role="note">
  <div class="capacity__header">
    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
      <rect x="1" y="7" width="2.5" height="5" rx="1" fill="currentColor"/>
      <rect x="5.25" y="4" width="2.5" height="8" rx="1" fill="currentColor"/>
      <rect x="9.5" y="1" width="2.5" height="11" rx="1" fill="currentColor"/>
    </svg>
    {title}
  </div>
  <div class="capacity__body">
    <slot />
  </div>
</aside>

<style>
  .capacity {
    background: rgba(100, 160, 120, 0.06);
    border: 1px solid rgba(100, 160, 120, 0.25);
    border-left: 3px solid rgba(100, 160, 120, 0.7);
    border-radius: var(--r-md);
    margin: 2rem 0;
    overflow: hidden;
  }
  .capacity__header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.125rem;
    color: #7ab89a;
    font-family: 'Geist', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(100, 160, 120, 0.2);
  }
  .capacity__body {
    padding: 1rem 1.125rem;
    font-size: 0.9125rem;
    line-height: 1.75;
    color: var(--ink-2);
  }
  .capacity__body :global(p) { margin: 0 0 0.5rem; }
  .capacity__body :global(p:last-child) { margin-bottom: 0; }
  .capacity__body :global(.katex-display) {
    margin: 0.875rem 0;
    overflow-x: auto;
  }
  .capacity__body :global(ul), .capacity__body :global(ol) {
    margin: 0.5rem 0;
    padding-left: 1.25rem;
  }
  .capacity__body :global(li) { margin: 0.2rem 0; }
  .capacity__body :global(strong) { color: #7ab89a; }
</style>
