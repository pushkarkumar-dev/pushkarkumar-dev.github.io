---
export interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<div class="tradeoff-table">
  {title && <p class="tradeoff-table__title">{title}</p>}
  <div class="tradeoff-table__body">
    <slot />
  </div>
</div>

<style>
  .tradeoff-table { margin: 2rem 0; }
  .tradeoff-table__title {
    margin: 0 0 8px;
    font-size: 0.9375rem;
    font-weight: 800;
    font-variation-settings: 'wdth' 112;
    color: var(--ink);
  }
  .tradeoff-table__body {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  /* Style the markdown table rendered inside the slot */
  .tradeoff-table__body :global(table) {
    width: 100%;
    min-width: 500px;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
  }
  .tradeoff-table__body :global(th) {
    padding: 8px 16px 8px 0;
    text-align: left;
    font-weight: 700;
    color: var(--ink);
    border-top: 1.5px solid var(--ink);
    border-bottom: 1.5px solid var(--ink);
    white-space: nowrap;
  }
  .tradeoff-table__body :global(td) {
    padding: 10px 16px 10px 0;
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .tradeoff-table__body :global(td:first-child) { font-weight: 700; }
  .tradeoff-table__body :global(strong) { font-weight: 700; }
</style>
