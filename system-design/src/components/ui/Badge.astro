---
export interface Props {
  variant: 'difficulty' | 'tag' | 'category';
  value: string;
  class?: string;
}

const { variant, value, class: className = '' } = Astro.props;

const difficultyLabel: Record<string, string> = {
  mid:    'Mid',
  senior: 'Senior',
  staff:  'Staff',
};
const difficultyLevel: Record<string, number> = { mid: 1, senior: 2, staff: 3 };

const categoryLabel: Record<string, string> = {
  foundations:   'Foundations',
  social:        'Social',
  media:         'Media',
  storage:       'Storage',
  commerce:      'Commerce',
  'search-maps': 'Search & Maps',
  realtime:      'Real-time',
  infra:         'Infra',
  ai:            'AI Systems',
};

const label =
  variant === 'difficulty' ? (difficultyLabel[value] ?? value) :
  variant === 'category'   ? (categoryLabel[value] ?? value) :
  value;

const level = difficultyLevel[value] ?? 0;
---

{variant === 'difficulty' ? (
  <span class:list={['level', 'badge', `badge--${variant}`, `badge--${value}`, className]}>
    <span class="meter" aria-hidden="true">
      {[1, 2, 3].map(n => <i class:list={[n <= level && 'on']} />)}
    </span>
    {label}
  </span>
) : (
  <span class:list={['badge', `badge--${variant}`, `badge--${value}`, className]}>
    {label}
  </span>
)}

<style>
  .badge {
    font-size: 0.875rem;
    line-height: 1.4;
    white-space: nowrap;
    color: var(--ink);
  }
  .badge--category { font-weight: 700; }
  .badge--tag {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--ink-2);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 1px 6px;
  }
</style>
