---
import ThemeToggle from '../ui/ThemeToggle.astro';

export interface Props {
  /** Highlight a specific category in the section bar — omit on landing page */
  activeCategory?: string;
}

const { activeCategory } = Astro.props;

const categories = [
  { slug: 'foundations',   label: 'Foundations' },
  { slug: 'social',        label: 'Social' },
  { slug: 'media',         label: 'Media' },
  { slug: 'storage',       label: 'Storage' },
  { slug: 'commerce',      label: 'Commerce' },
  { slug: 'search-maps',   label: 'Search' },
  { slug: 'realtime',      label: 'Real-time' },
  { slug: 'infra',         label: 'Infra' },
  { slug: 'ai',            label: 'AI' },
];

const base = import.meta.env.BASE_URL;
---

<!-- Site nav: same as the root pages. Root links are absolute and reload the page
     (data-astro-reload) because the root pages are not part of this Astro app. -->
<header id="sd-header" class="nav">
  <div class="wrap nav-inner">
    <a href="/index.html" class="brand" data-astro-reload>Pushkar Kumar</a>
    <button id="sd-nav-toggle" class="nav-toggle" aria-controls="sd-nav-links" aria-expanded="false">Menu</button>
    <nav id="sd-nav-links" class="nav-links" aria-label="Primary">
      <a href="/index.html#work" data-astro-reload>Work</a>
      <a href="/index.html#lab" data-astro-reload>Lab</a>
      <a href="/index.html#teaching" data-astro-reload>Teaching</a>
      <a href="/index.html#experience" data-astro-reload>Experience</a>
      <a href="/blog.html" data-astro-reload>Writing</a>
      <div class="nav-dropdown" id="sd-learn">
        <button class="nav-dropdown__trigger" aria-haspopup="true" aria-expanded="false">
          Learn
          <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </button>
        <div class="nav-dropdown__menu" role="menu">
          <a href="/dsa.html" role="menuitem" data-astro-reload>DSA revision</a>
          <a href={`${base}/`} role="menuitem" aria-current="page">System design</a>
          <a href="https://pushkarkumar-dev.github.io/system-design-labs/" target="_blank" rel="noopener" role="menuitem">Build labs</a>
          <a href="https://pushkarkumar-dev.github.io/ComputerConceptVisualization/" target="_blank" rel="noopener" role="menuitem">Concept visualizations</a>
        </div>
      </div>
      <a href="/index.html#contact" data-astro-reload>Contact</a>
    </nav>
  </div>
</header>

<!-- Section bar: this section's title, its categories, and the theme switch -->
<div class="section-bar">
  <div class="wrap section-bar__inner">
    <a href={`${base}/`} class="section-bar__title">System design</a>
    <nav class="section-bar__cats" aria-label="Categories">
      {categories.map(cat => (
        <a
          href={`${base}/?category=${cat.slug}`}
          class:list={['section-bar__cat', activeCategory === cat.slug && 'active']}
          aria-current={activeCategory === cat.slug ? 'true' : undefined}
        >
          {cat.label}
        </a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</div>

<style>
  /* ── Site nav (matches index.html) ── */
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color .2s;
  }
  .nav.scrolled { border-bottom-color: var(--rule); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; height: var(--nav-h); }

  .brand {
    font-weight: 800; font-variation-settings: 'wdth' 125;
    font-size: 1.0625rem; text-decoration: none; letter-spacing: -0.01em;
    color: var(--ink);
  }

  .nav-links { display: flex; align-items: center; gap: 28px; font-size: 0.9375rem; }
  .nav-links a, .nav-dropdown__trigger { text-decoration: none; color: var(--ink-2); }
  .nav-links a:hover, .nav-dropdown__trigger:hover { color: var(--ink); text-decoration: underline; }

  .nav-dropdown { position: relative; }
  .nav-dropdown__trigger {
    font: inherit; background: none; border: 0; padding: 0; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .nav-dropdown__trigger svg { transition: transform .2s; }
  .nav-dropdown.open .nav-dropdown__trigger svg { transform: rotate(180deg); }
  .nav-dropdown__menu {
    position: absolute; right: 0; top: calc(100% + 14px);
    min-width: 220px; padding: 8px 0;
    background: var(--panel); border: 1px solid var(--ink);
    display: none;
  }
  .nav-dropdown.open .nav-dropdown__menu { display: block; }
  .nav-links .nav-dropdown__menu a { display: block; padding: 8px 16px; color: var(--ink); }
  .nav-links .nav-dropdown__menu a:hover { background: var(--signal); color: var(--on-signal); text-decoration: none; }
  .nav-links .nav-dropdown__menu a[aria-current="page"] { font-weight: 700; }

  .nav-toggle {
    display: none; font: inherit; font-size: 0.9375rem; color: var(--ink);
    background: none; border: 1px solid var(--ink); padding: 6px 12px; cursor: pointer;
  }

  @media (max-width: 760px) {
    .nav-toggle { display: block; }
    .nav-links {
      display: none;
      position: absolute; left: 0; right: 0; top: var(--nav-h);
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--paper); border-bottom: 1px solid var(--ink);
      padding: 8px var(--gutter) 16px;
    }
    .nav-links.open { display: flex; }
    .nav-links > a, .nav-dropdown__trigger { padding: 10px 0; color: var(--ink); font-size: 1.0625rem; }
    .nav-dropdown__trigger { display: none; }
    .nav-dropdown__menu { display: block; position: static; border: 0; background: none; padding: 0; }
    .nav-links .nav-dropdown__menu a { padding: 10px 0; font-size: 1.0625rem; }
  }

  /* ── Section bar ── */
  .section-bar { border-bottom: 1.5px solid var(--ink); }
  .section-bar__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 56px;
  }
  .section-bar__title {
    flex: none;
    font-weight: 800;
    font-variation-settings: 'wdth' 112;
    font-size: 1.0625rem;
    color: var(--ink);
    text-decoration: none;
  }
  .section-bar__title:hover { text-decoration: underline; }

  .section-bar__cats {
    flex: 1;
    min-width: 0;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 10px 0;
  }
  .section-bar__cats::-webkit-scrollbar { display: none; }
  .section-bar__cat {
    flex: none;
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 2px;
    white-space: nowrap;
  }
  .section-bar__cat:hover { color: var(--ink); text-decoration: underline; }
  .section-bar__cat.active { background: var(--signal); color: var(--on-signal); font-weight: 700; }

  @media (max-width: 640px) {
    .section-bar__inner { gap: 12px; }
  }
</style>

<script>
  function initHeader() {
    onNavScroll();

    // On narrow screens the category row scrolls sideways; bring the current one into view
    const cats = document.querySelector<HTMLElement>('.section-bar__cats');
    const active = cats?.querySelector<HTMLElement>('.section-bar__cat.active');
    if (cats && active) {
      cats.scrollLeft = active.offsetLeft - cats.offsetLeft - (cats.clientWidth - active.offsetWidth) / 2;
    }

    // Mobile menu
    const toggle = document.getElementById('sd-nav-toggle');
    const links  = document.getElementById('sd-nav-links');
    if (toggle && links) {
      toggle.addEventListener('click', () => {
        const open = links.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
        toggle.textContent = open ? 'Close' : 'Menu';
      });
    }

    // Learn dropdown
    const learn = document.getElementById('sd-learn');
    const trigger = learn?.querySelector<HTMLButtonElement>('.nav-dropdown__trigger');
    if (learn && trigger) {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = learn.classList.toggle('open');
        trigger.setAttribute('aria-expanded', String(open));
      });
    }
  }

  // Rule under the nav once the page scrolls
  const onNavScroll = () =>
    document.getElementById('sd-header')?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onNavScroll, { passive: true });

  // Document-level listeners are added once; they look up the current dropdown each time.
  const closeLearn = () => {
    const learn = document.getElementById('sd-learn');
    if (!learn) return;
    learn.classList.remove('open');
    learn.querySelector('.nav-dropdown__trigger')?.setAttribute('aria-expanded', 'false');
  };
  document.addEventListener('click', closeLearn);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLearn(); });

  document.addEventListener('astro:page-load', initHeader);
</script>
