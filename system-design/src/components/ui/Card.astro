---
export interface Props {
  href?: string;
  class?: string;
  hoverable?: boolean;
}

const { href, class: className = '', hoverable = !!href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['card', hoverable && 'card--hoverable', className]}
  href={href}
>
  <slot />
</Tag>

<style>
  .card {
    display: block;
    border-top: 1px solid var(--rule);
    padding: 1.25rem 0;
    text-decoration: none;
    color: inherit;
  }
  .card--hoverable:hover { background: var(--raised); }
</style>
