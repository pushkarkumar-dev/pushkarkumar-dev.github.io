---
export interface Props {
  variant?: 'primary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font: inherit;
    font-weight: 600;
    border-radius: 0;
    cursor: pointer;
    text-decoration: none;
    border: 1px solid var(--ink);
    white-space: nowrap;
    line-height: 1;
  }
  .btn:disabled { opacity: 0.45; pointer-events: none; }

  /* Sizes */
  .btn--sm { font-size: 0.8125rem; padding: 0.45em 0.875em; }
  .btn--md { font-size: 0.9375rem; padding: 0.6em 1.125em; }
  .btn--lg { font-size: 1rem;      padding: 0.7em 1.375em; }

  /* Primary: yellow fill, ink text */
  .btn--primary { background: var(--signal); color: var(--on-signal); }
  .btn--primary:hover { background: var(--signal-deep); }

  /* Ghost */
  .btn--ghost { background: transparent; color: var(--ink); border-color: transparent; }
  .btn--ghost:hover { background: var(--raised); }

  /* Outline */
  .btn--outline { background: transparent; color: var(--ink); }
  .btn--outline:hover { background: var(--signal); color: var(--on-signal); }
</style>
