---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import QuestionCard from '../components/ui/QuestionCard.astro';
import { getCollection } from 'astro:content';

const questions = await getCollection('system-design');
questions.sort((a, b) => a.data.publishedAt.localeCompare(b.data.publishedAt));

const totalCount = questions.length;

const categories = [
  { slug: 'all',         label: 'All' },
  { slug: 'foundations', label: 'Foundations' },
  { slug: 'social',      label: 'Social' },
  { slug: 'media',       label: 'Media' },
  { slug: 'storage',     label: 'Storage' },
  { slug: 'commerce',    label: 'Commerce' },
  { slug: 'search-maps', label: 'Search & Maps' },
  { slug: 'realtime',    label: 'Real-time' },
  { slug: 'infra',       label: 'Infra' },
  { slug: 'ai',          label: 'AI Systems' },
];

const difficulties = [
  { slug: 'all',    label: 'All levels', level: 0 },
  { slug: 'mid',    label: 'Mid',        level: 1 },
  { slug: 'senior', label: 'Senior',     level: 2 },
  { slug: 'staff',  label: 'Staff',      level: 3 },
];
---

<BaseLayout title="System Design Interview Prep — pushkar.dev">
  <Header />

  <main id="main-content" class="sd-main">

    <!-- ─── Hero ──────────────────────────────────── -->
    <section class="hero" aria-label="Introduction">
      <div class="wrap">
        <h1 class="hero__title">System design interview prep</h1>
        <p class="hero__sub">
          {totalCount} questions worked through at staff-level depth: capacity math, tradeoff tables,
          and the non-obvious insights that separate a senior answer from a principal one.
        </p>
        <dl class="hero__stats">
          <div><dt>questions</dt><dd>{totalCount}</dd></div>
          <div><dt>levels, mid to staff</dt><dd>3</dd></div>
          <div><dt>categories</dt><dd>9</dd></div>
        </dl>
      </div>
    </section>

    <!-- ─── Filters ───────────────────────────────── -->
    <section class="filters" aria-label="Filter questions">
      <div class="wrap filters__inner">

        <div class="filters__row">
          <span class="filters__label" id="cat-label">Topic</span>
          <div class="filter-group" role="group" aria-labelledby="cat-label">
            {categories.map(cat => (
              <button
                class="fchip"
                data-filter-cat={cat.slug}
                aria-pressed={cat.slug === 'all' ? 'true' : 'false'}
              >
                {cat.label}
              </button>
            ))}
          </div>
        </div>

        <div class="filters__row">
          <span class="filters__label" id="diff-label">Level</span>
          <div class="filter-group" role="group" aria-labelledby="diff-label">
            {difficulties.map(d => (
              <button
                class="fchip fchip--diff"
                data-filter-diff={d.slug}
                aria-pressed={d.slug === 'all' ? 'true' : 'false'}
              >
                {d.level > 0 && (
                  <span class="meter" aria-hidden="true">
                    {[1, 2, 3].map(n => <i class:list={[n <= d.level && 'on']} />)}
                  </span>
                )}
                {d.label}
              </button>
            ))}
          </div>
        </div>

        <div class="filters__bottom">
          <label class="search-wrap">
            <span class="sr-only">Search questions</span>
            <input
              id="search-input"
              type="search"
              class="search-input"
              placeholder="Search by title or tag"
              autocomplete="off"
            />
          </label>
          <p id="question-count" class="q-count" aria-live="polite">
            Showing <strong id="q-num">{totalCount}</strong> of {totalCount} questions
          </p>
        </div>

      </div>
    </section>

    <!-- ─── Question list ────────────────────────── -->
    <section class="grid-section" aria-label="Questions">
      <div class="wrap">

        <div id="question-grid" class="q-grid">
          {questions.map(q => (
            <QuestionCard
              title={q.data.title}
              slug={q.id}
              category={q.data.category}
              difficulty={q.data.difficulty}
              summary={q.data.summary}
              tags={q.data.tags}
              estimatedReadMinutes={q.data.estimatedReadMinutes}
            />
          ))}
        </div>

        <p id="no-results" class="no-results" hidden>
          No questions match these filters.
          <button id="clear-filters" class="clear-btn">Clear filters</button>
        </p>

        <!-- Pagefind search results (populated at runtime after build) -->
        <div id="pagefind-search" class="pagefind-wrap" hidden></div>

      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<!-- ─── Styles ──────────────────────────────────── -->
<style>
  .sd-main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Hero */
  .hero { padding: 48px 0 40px; }
  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 125;
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 20px;
    max-width: 14em;
  }
  .hero__sub {
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--ink);
    max-width: 38em;
    margin: 0;
  }
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 48px;
    margin: 32px 0 0;
  }
  .hero__stats div { display: flex; flex-direction: column-reverse; }
  .hero__stats dd {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 700;
    font-variation-settings: 'wdth' 72;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .hero__stats dt { margin-top: 6px; font-size: 0.875rem; color: var(--ink-2); }

  /* Filters */
  .filters {
    position: sticky;
    top: var(--nav-h);
    z-index: 30;
    background: var(--paper);
    border-top: 1.5px solid var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .filters__inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .filters__row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: start;
    gap: 12px;
  }
  .filters__label { font-size: 0.875rem; font-weight: 700; padding-top: 6px; }
  .filter-group { display: flex; flex-wrap: wrap; gap: 8px; }

  .fchip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.2;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }
  .fchip:hover { border-color: var(--ink); }
  .fchip[aria-pressed="true"] {
    background: var(--signal);
    border-color: var(--ink);
    color: var(--on-signal);
    font-weight: 700;
  }
  .fchip[aria-pressed="true"] :global(.meter i) { border-color: var(--on-signal); }
  .fchip[aria-pressed="true"] :global(.meter i.on) { background: var(--on-signal); }

  .filters__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .search-wrap { flex: 1; max-width: 360px; display: block; }
  .search-input {
    width: 100%;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--ink);
    border-radius: 0;
    padding: 8px 12px;
  }
  .search-input::placeholder { color: var(--ink-2); }
  .search-input:focus { outline: 3px solid var(--signal); outline-offset: 0; }
  .search-input::-webkit-search-cancel-button { display: none; }

  .q-count { font-size: 0.9375rem; color: var(--ink-2); margin: 0; white-space: nowrap; }
  .q-count strong { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums; }

  @media (max-width: 640px) {
    /* On phones the filters scroll with the page so the list keeps the screen */
    .filters { position: static; }
    .filters__row { grid-template-columns: 1fr; gap: 6px; }
    .filters__label { padding-top: 0; }
    .search-wrap { max-width: none; flex-basis: 100%; }
  }

  /* List */
  .grid-section {
    flex: 1;
    padding: 8px 0 72px;
  }
  .q-grid { display: flex; flex-direction: column; }

  .no-results {
    color: var(--ink-2);
    font-size: 1rem;
    padding: 48px 0;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .no-results[hidden] { display: none; }
  .clear-btn {
    font: inherit;
    font-size: 0.9375rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--ink);
    padding: 6px 12px;
    cursor: pointer;
  }
  .clear-btn:hover { background: var(--signal); color: var(--on-signal); }

  .pagefind-wrap { margin-top: 2rem; }
</style>

<!-- ─── Client-side filter logic ─────────────────── -->
<script>
  function initFilters() {
    const params = new URLSearchParams(location.search);
    let activeCat  = params.get('category')   || 'all';
    let activeDiff = params.get('difficulty')  || 'all';
    let query      = params.get('q')           || '';

    const cards    = Array.from(document.querySelectorAll<HTMLElement>('.q-card'));
    const countEl  = document.getElementById('q-num');
    const noRes    = document.getElementById('no-results') as HTMLElement | null;
    const searchEl = document.getElementById('search-input') as HTMLInputElement | null;

    // Only run on the index page (cards must exist)
    if (!cards.length) return;

    function applyFilters() {
      let visible = 0;
      const lq = query.toLowerCase();

      cards.forEach(card => {
        const catOk  = activeCat  === 'all' || card.dataset.category  === activeCat;
        const diffOk = activeDiff === 'all' || card.dataset.difficulty === activeDiff;
        const textOk = !lq ||
          (card.dataset.title ?? '').includes(lq) ||
          (card.dataset.tags  ?? '').includes(lq);

        const show = catOk && diffOk && textOk;
        card.hidden = !show;
        if (show) visible++;
      });

      if (countEl) countEl.textContent = String(visible);
      if (noRes) noRes.hidden = visible > 0;

      // Sync URL (replace state so back button works correctly)
      const np = new URLSearchParams();
      if (activeCat  !== 'all') np.set('category',   activeCat);
      if (activeDiff !== 'all') np.set('difficulty',  activeDiff);
      if (query)                np.set('q',           query);
      history.replaceState({}, '', np.toString() ? `?${np}` : location.pathname);

      // Sync chip states
      document.querySelectorAll<HTMLElement>('[data-filter-cat]').forEach(b => {
        b.setAttribute('aria-pressed', String(b.dataset.filterCat === activeCat));
      });
      document.querySelectorAll<HTMLElement>('[data-filter-diff]').forEach(b => {
        b.setAttribute('aria-pressed', String(b.dataset.filterDiff === activeDiff));
      });
    }

    // Category chips — fresh listeners on every page-load
    document.querySelectorAll<HTMLElement>('[data-filter-cat]').forEach(btn => {
      btn.addEventListener('click', () => {
        activeCat = btn.dataset.filterCat!;
        applyFilters();
      });
    });

    // Difficulty chips
    document.querySelectorAll<HTMLElement>('[data-filter-diff]').forEach(btn => {
      btn.addEventListener('click', () => {
        activeDiff = btn.dataset.filterDiff!;
        applyFilters();
      });
    });

    // Search
    if (searchEl) {
      searchEl.value = query;
      searchEl.addEventListener('input', () => {
        query = searchEl.value;
        applyFilters();
      });
    }

    // Clear filters button
    document.getElementById('clear-filters')?.addEventListener('click', () => {
      activeCat = 'all'; activeDiff = 'all'; query = '';
      if (searchEl) searchEl.value = '';
      applyFilters();
    });

    // Apply immediately (reads current URL params)
    applyFilters();
  }

  // astro:page-load fires after every navigation (including the initial load),
  // so event listeners and URL params are always re-initialized on fresh DOM.
  document.addEventListener('astro:page-load', initFilters);
</script>
