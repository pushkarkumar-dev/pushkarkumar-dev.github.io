---
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<aside class="pitfall" role="note">
  <div class="pitfall__header">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M7 1.5L13 12.5H1L7 1.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      <line x1="7" y1="5.5" x2="7" y2="8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <circle cx="7" cy="10.5" r="0.7" fill="currentColor"/>
    </svg>
    <span><span class="pitfall__label">Pitfall:</span> {title}</span>
  </div>
  <div class="pitfall__body">
    <slot />
  </div>
</aside>

<style>
  .pitfall {
    border-left: 4px solid var(--ink);
    margin: 1.75rem 0;
    padding: 2px 0 2px 20px;
  }
  .pitfall__header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .pitfall__header svg { flex: none; align-self: center; }
  .pitfall__label { font-weight: 800; font-variation-settings: 'wdth' 112; }
  .pitfall__body {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .pitfall__body :global(p) { margin: 0 0 0.5rem; }
  .pitfall__body :global(p:last-child) { margin-bottom: 0; }
  .pitfall__body :global(strong) { font-weight: 700; }
</style>
