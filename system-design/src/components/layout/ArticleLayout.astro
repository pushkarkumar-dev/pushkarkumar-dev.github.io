---
import Header from './Header.astro';
import Footer from './Footer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../ui/Badge.astro';

export interface Props {
  title: string;
  description?: string;
  category: string;
  difficulty: 'mid' | 'senior' | 'staff';
  tags?: string[];
  estimatedReadMinutes?: number;
  publishedAt?: string;
  updatedAt?: string;
  ogImage?: string;
}

const {
  title,
  description,
  category,
  difficulty,
  tags = [],
  estimatedReadMinutes,
  publishedAt,
  updatedAt,
  ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  ...(ogImage && { image: ogImage }),
  url: canonicalUrl.toString(),
  ...(publishedAt && { datePublished: publishedAt }),
  ...(updatedAt   && { dateModified:  updatedAt }),
  author: {
    '@type': 'Person',
    name: 'Pushkar Kumar',
    url: 'https://pushkar1005.github.io',
  },
  keywords: tags.join(', '),
});
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <!-- KaTeX CSS — only on article pages -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
    crossorigin="anonymous"
  />
  <!-- JSON-LD structured data -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <Header activeCategory={category} />

  <div class="article-shell">

    <!-- Reading progress bar -->
    <div id="reading-progress" class="reading-progress" role="progressbar" aria-valuenow={0} aria-valuemin={0} aria-valuemax={100} aria-label="Reading progress"></div>

    <div class="wrap article-layout">

      <!-- Sidebar TOC (desktop only) -->
      <aside class="article-toc" aria-label="Table of contents">
        <div class="article-toc__inner">
          <p class="article-toc__heading">On this page</p>
          <nav class="toc-nav">
            <slot name="toc" />
          </nav>
        </div>
      </aside>

      <!-- Main article -->
      <main id="main-content" class="article-main">

        <!-- Article header -->
        <header class="article-header">
          <div class="article-header__meta">
            <Badge variant="category" value={category} />
            <Badge variant="difficulty" value={difficulty} />
            {estimatedReadMinutes && (
              <span class="article-header__read-time">{estimatedReadMinutes} min read</span>
            )}
          </div>

          <h1 class="article-header__title">{title}</h1>

          {description && (
            <p class="article-header__summary">{description}</p>
          )}

          {tags.length > 0 && (
            <p class="article-header__tags">
              <span class="article-header__tags-label">Tags</span>
              {tags.map(tag => <Badge variant="tag" value={tag} />)}
            </p>
          )}

          {(publishedAt || updatedAt) && (
            <p class="article-header__dates">
              {publishedAt && (
                <time datetime={publishedAt}>
                  Published {new Date(publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}.
                </time>
              )}
              {updatedAt && updatedAt !== publishedAt && (
                <time datetime={updatedAt}>
                  Updated {new Date(updatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}.
                </time>
              )}
            </p>
          )}
        </header>

        <!-- Article body (data-pagefind-body marks this for Pagefind indexing) -->
        <div class="prose" data-pagefind-body>
          <slot />
        </div>

      </main>
    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: var(--signal);
    z-index: 100;
  }

  .article-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    padding-top: 40px;
    padding-bottom: 72px;
    gap: 48px;
  }

  @media (min-width: 1024px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr) 232px;
      grid-template-areas: 'main toc';
    }
    .article-main { grid-area: main; }
    .article-toc  { grid-area: toc; }
  }

  /* TOC sidebar */
  .article-toc { display: none; }
  @media (min-width: 1024px) {
    .article-toc { display: block; }
    .article-toc__inner {
      position: sticky;
      top: calc(var(--nav-h) + 24px);
      max-height: calc(100vh - var(--nav-h) - 48px);
      overflow-y: auto;
      scrollbar-width: none;
      border-top: 1.5px solid var(--ink);
      padding-top: 12px;
    }
    .article-toc__inner::-webkit-scrollbar { display: none; }
  }

  .article-toc__heading {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 8px;
  }

  /* Article header */
  .article-main { min-width: 0; }

  .article-header {
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1.5px solid var(--ink);
  }

  .article-header__meta {
    display: flex;
    align-items: center;
    gap: 8px 24px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .article-header__read-time { font-size: 0.875rem; color: var(--ink-2); }

  .article-header__title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 125;
    color: var(--ink);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0 0 16px;
    max-width: 18em;
  }

  .article-header__summary {
    font-size: 1.25rem;
    color: var(--ink);
    line-height: 1.45;
    margin: 0 0 20px;
    max-width: 38em;
  }

  .article-header__tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 12px;
  }
  .article-header__tags-label { font-size: 0.875rem; font-weight: 700; margin-right: 6px; }

  .article-header__dates {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 0.875rem;
    color: var(--ink-2);
    margin: 0;
  }
</style>

<style>
  /* ── TOC links (from named slot) ───────────────────── */
  .toc-nav :global(a) {
    display: block;
    font-size: 0.875rem;
    color: var(--ink-2);
    text-decoration: none;
    padding: 5px 8px;
    line-height: 1.35;
    border-radius: 2px;
  }
  .toc-nav :global(a:hover) { color: var(--ink); text-decoration: underline; }
  .toc-nav :global(a.toc-active) {
    background: var(--signal);
    color: var(--on-signal);
    font-weight: 700;
    text-decoration: none;
  }
  .toc-nav :global(a.toc-h3) { padding-left: 20px; font-size: 0.8125rem; }

  /* ── Copy button on code blocks ────────────────────── */
  :global(pre) { position: relative !important; }
  :global(.copy-btn) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 28px;
    padding: 0 8px;
    font: inherit;
    font-family: var(--font);
    font-size: 0.8125rem;
    background: var(--panel);
    border: 1px solid var(--ink);
    border-radius: 0;
    color: var(--ink);
    cursor: pointer;
    opacity: 0;
    z-index: 2;
  }
  :global(pre:hover .copy-btn), :global(.copy-btn:focus-visible) { opacity: 1; }
  :global(.copy-btn:hover) { background: var(--signal); color: var(--on-signal); }
  :global(.copy-btn.copied) { opacity: 1; background: var(--signal); color: var(--on-signal); }
  :global(.copy-btn .check-icon) { display: none; }
  :global(.copy-btn.copied .copy-icon) { display: none; }
  :global(.copy-btn.copied .check-icon) { display: block; }
  @media (hover: none) { :global(.copy-btn) { opacity: 1; } }
</style>

<!-- Article behavior: reading progress, Mermaid, TOC scroll-spy, copy buttons.
     Runs on every astro:page-load so it also works after client-side navigation
     between questions. Window/document listeners are added once and look up the
     current page's elements each time. -->
<script>
  const palettes = {
    light: { paper: '#ECEEEF', panel: '#F7F8F8', raised: '#E1E5E8', ink: '#15202B', ink2: '#4A5560', rule: '#7D8994' },
    dark:  { paper: '#121A22', panel: '#18222C', raised: '#202B36', ink: '#E6EAED', ink2: '#9AA6B1', rule: '#5A6773' },
  };

  // ── Reading progress ───────────────────────────────
  function updateProgress() {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;
    const el = document.documentElement;
    const total = el.scrollHeight - el.clientHeight;
    const pct = total > 0 ? Math.round((el.scrollTop / total) * 100) : 0;
    bar.style.width = `${pct}%`;
    bar.setAttribute('aria-valuenow', String(pct));
  }

  // ── TOC scroll-spy ─────────────────────────────────
  function syncToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-nav a'));
    if (!links.length) return;
    let activeId = '';
    for (const a of links) {
      const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (!el) continue;
      if (!activeId || el.getBoundingClientRect().top < 200) activeId = el.id;
    }
    links.forEach(a => a.classList.toggle('toc-active', decodeURIComponent(a.hash.slice(1)) === activeId));
  }

  window.addEventListener('scroll', () => { updateProgress(); syncToc(); }, { passive: true });

  // ── Mermaid ────────────────────────────────────────
  let mermaidPromise: Promise<any> | null = null;
  function doRenderMermaid(): Promise<void> {
    const diagrams = Array.from(document.querySelectorAll<HTMLElement>('.mermaid'));
    if (!diagrams.length) return Promise.resolve();
    diagrams.forEach(el => { if (el.dataset.source === undefined) el.dataset.source = el.textContent ?? ''; });

    mermaidPromise ??= import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs').then(m => m.default);
    return mermaidPromise.then(mermaid => {
      const dark = document.documentElement.getAttribute('data-theme') === 'dark';
      const p = dark ? palettes.dark : palettes.light;
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        fontFamily: 'Archivo, system-ui, sans-serif',
        themeVariables: {
          darkMode: dark,
          fontFamily: 'Archivo, system-ui, sans-serif',
          background: p.panel,
          primaryColor: p.panel,
          primaryTextColor: p.ink,
          primaryBorderColor: p.ink,
          secondaryColor: p.raised,
          secondaryTextColor: p.ink,
          secondaryBorderColor: p.rule,
          tertiaryColor: p.paper,
          tertiaryTextColor: p.ink,
          tertiaryBorderColor: p.rule,
          lineColor: p.ink2,
          textColor: p.ink,
          mainBkg: p.panel,
          nodeBorder: p.ink,
          clusterBkg: p.raised,
          clusterBorder: p.rule,
          titleColor: p.ink,
          edgeLabelBackground: p.panel,
          actorBkg: p.panel,
          actorBorder: p.ink,
          actorTextColor: p.ink,
          actorLineColor: p.ink2,
          signalColor: p.ink,
          signalTextColor: p.ink,
          labelBoxBkgColor: p.raised,
          labelBoxBorderColor: p.rule,
          labelTextColor: p.ink,
          loopTextColor: p.ink,
          noteBkgColor: '#FFC628',
          noteTextColor: '#15202B',
          noteBorderColor: '#15202B',
          activationBkgColor: p.raised,
          activationBorderColor: p.ink,
          sequenceNumberColor: p.paper,
        },
      });
          diagrams.forEach(el => {
            el.removeAttribute('data-processed');
            el.textContent = el.dataset.source ?? '';
          });
      diagrams.forEach(el => {
        el.removeAttribute('data-processed');
        el.textContent = el.dataset.source ?? '';
      });
      return mermaid.run({ nodes: diagrams, suppressErrors: true });
    }).catch(() => {});
  }

  // Renders run one at a time (overlapping mermaid.run calls on the same nodes
  // throw), and requests that arrive while one is queued collapse into it.
  let renderQueue: Promise<void> = Promise.resolve();
  let renderQueued = false;
  function renderMermaid() {
    if (renderQueued) return;
    renderQueued = true;
    renderQueue = renderQueue.then(() => {
      renderQueued = false;
      return doRenderMermaid();
    });
  }

  // Re-render diagrams in the new palette when the reader switches theme
  new MutationObserver(renderMermaid).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });

  // ── Copy buttons ───────────────────────────────────
  const COPY_SVG  = `<svg class="copy-icon"  width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="4.5" y=".5" width="9" height="11" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M3 3H2A1.5 1.5 0 0 0 .5 4.5v8A1.5 1.5 0 0 0 2 14h7A1.5 1.5 0 0 0 10.5 12.5V11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>`;
  const CHECK_SVG = `<svg class="check-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7.5L5.5 11L12 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

  function addCopyButtons() {
    document.querySelectorAll<HTMLElement>('.prose pre').forEach(pre => {
      const code = pre.querySelector('code');
      if (!code || pre.querySelector('.copy-btn')) return;
      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.innerHTML = COPY_SVG + CHECK_SVG + '<span class="copy-label">Copy</span>';
      const label = btn.querySelector('.copy-label')!;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          btn.classList.add('copied');
          label.textContent = 'Copied';
          setTimeout(() => {
            btn.classList.remove('copied');
            label.textContent = 'Copy';
          }, 1800);
        } catch {}
      });
      pre.appendChild(btn);
    });
  }

  document.addEventListener('astro:page-load', () => {
    updateProgress();
    syncToc();
    renderMermaid();
    addCopyButtons();
  });
</script>
