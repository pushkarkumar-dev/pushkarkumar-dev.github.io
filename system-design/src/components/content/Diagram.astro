---
export interface Props {
  caption?: string;
  alt?: string;
}
const { caption, alt } = Astro.props;
---

<figure class="diagram" aria-label={alt ?? caption}>
  <div class="diagram__body">
    <slot />
  </div>
  {caption && (
    <figcaption class="diagram__caption">{caption}</figcaption>
  )}
</figure>

<style>
  .diagram {
    margin: 2.5rem 0;
  }
  .diagram__body {
    background: var(--bg-card);
    border: 1px solid var(--line-2);
    border-radius: var(--r-lg);
    padding: 1.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* SVG and mermaid output inside diagram */
  .diagram__body :global(svg) {
    max-width: 100%;
    height: auto;
    display: block;
  }
  .diagram__body :global(.mermaid svg) {
    max-width: 100%;
    height: auto;
  }
  .diagram__caption {
    margin: 0.625rem 0 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--ink-4);
    font-style: italic;
    line-height: 1.5;
  }
</style>
